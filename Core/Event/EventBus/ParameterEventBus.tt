namespace PeroTools2.AccessKing;
<#
for (var i = 0; i < 17; i++)
{
    var genericArgs = string.Empty;
    var baseGenericArgs = "Empty";
    if (i >= 1)
    {
        genericArgs = i == 1 ? "<T>" : $"<{string.Join(", ", from index in Enumerable.Range(1, i) select $"T{index}")}>";
        baseGenericArgs = i == 1 ? "ParameterNotification<T>" : $"ParameterNotification<{string.Join(", ", from index in Enumerable.Range(1, i) select $"T{index}")}>";
    }
#>

/// <summary>
/// Event bus with ParameterNotification wrapper.
/// </summary>
public class ParameterEventBus<#= genericArgs #> : EventBus<<#= baseGenericArgs #>>;
<#
}
#>