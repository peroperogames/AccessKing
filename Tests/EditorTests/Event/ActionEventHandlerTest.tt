<#
    var testCase = string.Join("\n", from index in Enumerable.Range(0, 17) select $"\t\t[TestCase({index})]");
#>

using System;
using NUnit.Framework;

namespace PeroTools2.AccessKing.Editor.Tests
{
    // ReSharper disable All
    public sealed class ActionEventHandlerTest
    {
        private int m_HandleCount;
        private bool m_IsInvoke;

        [SetUp]
        public void SetUp()
        {
            m_HandleCount = 0;
            m_IsInvoke = false;
        }
<#
    for (var i = 0; i < 17; i++)
    {
        var parameters = string.Empty;
        if (i > 0)
        {
            parameters = i == 1 ? "object p" : string.Join(", ", from index in Enumerable.Range(1, i) select $"object p{index}");
        }
#>

        private void Test(<#= parameters #>)
        {
            m_HandleCount++;
            m_IsInvoke = true;
        }
<#
    }
#>

<#=testCase#>
        public void HandlerInvokeTest(int argumentCount)
        {
            switch (argumentCount)
            {
<#
            for (var i = 0; i < 17; i++)
            {
                var objectArg = i == 0 ? string.Empty : $"<{string.Join(", ", from index in Enumerable.Range(1, i) select "object")}>";
                var param = i == 0 ? string.Empty : string.Join(", ", from index in Enumerable.Range(1, i) select "default");
#>
                case <#= i #>:
                    var handler<#= i #> = new ActionEventHandler<#= objectArg #>(Test);
                    handler<#= i #>.Handle(<#=param#>);
                    break;
<#
            }
#>
            }
            Assert.IsTrue(m_IsInvoke);
        }

<#=testCase#>
        public void EqualsWithActionEventHandlerTest(int argumentCount)
        {
            switch (argumentCount)
            {
<#
            for (var i = 0; i < 17; i++)
            {
                var objectArg = i == 0 ? string.Empty : $"<{string.Join(", ", from index in Enumerable.Range(1, i) select "object")}>";
#>
                case <#= i #>:
                    var handler<#= i #>_1 = new ActionEventHandler<#= objectArg #>(Test);
                    var handler<#= i #>_2 = new ActionEventHandler<#= objectArg #>(Test);
                    Assert.IsTrue(handler<#= i #>_1 == handler<#= i #>_2);
                    Assert.IsTrue(handler<#= i #>_1.Equals(handler<#= i #>_2));
                    break;
<#
            }
#>
            }
        }

<#=testCase#>
        public void EqualsWithActionDelegateTest(int argumentCount)
        {
            switch (argumentCount)
            {
<#
            for (var i = 0; i < 17; i++)
            {
                var objectArg = i == 0 ? string.Empty : $"<{string.Join(", ", from index in Enumerable.Range(1, i) select "object")}>";
#>
                case <#= i #>:
                    var handler<#= i #>_1 = new ActionEventHandler<#= objectArg #>(Test);
                    var handler<#= i #>_2 = new Action<#= objectArg #>(Test);
                    Assert.IsTrue(handler<#= i #>_1 == handler<#= i #>_2);
                    Assert.IsTrue(handler<#= i #>_1.Equals(handler<#= i #>_2));
                    break;
<#
            }
#>
            }
        }

<#=testCase#>
        public void EventBusInvokeWithActionHandlerTest(int argumentCount)
        {
            switch (argumentCount)
            {
<#
            for (var i = 0; i < 17; i++)
            {
                
                var objectArg = i == 0 ? "Empty" : $"ParameterNotification<{string.Join(", ", from index in Enumerable.Range(1, i) select "object")}>";
                var param = i == 0 ? string.Empty : string.Join(", ", from index in Enumerable.Range(1, i) select "default");

#>
                case <#= i #>:
                    var bus<#= i #> = new EventBus<<#=objectArg#>>();
                    bus<#= i #>.Subscribe(Test);
                    bus<#= i #>.Broadcast(<#=param#>);
                    break;
<#
            }
#>
            }
            Assert.IsTrue(m_HandleCount == 1);
        }

<#=testCase#>
        public void EventBusUnsubscribeWithActionHandlerTest(int argumentCount)
        {
            const int handlerCount = 5;
            switch (argumentCount)
            {
<#
            for (var i = 0; i < 17; i++)
            {
                
                var objectArg = i == 0 ? "Empty" : $"ParameterNotification<{string.Join(", ", from index in Enumerable.Range(1, i) select "object")}>";
                var param = i == 0 ? string.Empty : string.Join(", ", from index in Enumerable.Range(1, i) select "default");
#>
                case <#= i #>:
                    var bus<#= i #> = new EventBus<<#=objectArg#>>();
                    for (var i = 0; i < handlerCount; i++)
                    {
                        bus<#= i #>.Subscribe(Test);
                    }
                    Assert.IsTrue(bus<#= i #>.Unsubscribe(Test));
                    bus<#= i #>.Broadcast(<#=param#>);
                    break;
<#
            }
#>
            }
            Assert.IsTrue(m_HandleCount == handlerCount - 1);
        }
    }
}