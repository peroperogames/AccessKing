using System;
using System.Reflection;

namespace PeroTools2.AccessKing
{
<#
    for (var i = 0; i < 16; i++)
    {
        var genericArgs = i == 0 ? string.Empty : (i == 1 ? "T" : string.Join(", ", from index in Enumerable.Range(1, i) select $"T{index}"));
        var genericArgsWithAngleBrackets = i == 0 ? string.Empty : $"<{genericArgs}>";
        var parameterNotification = i == 0 ? "Empty" : $"ParameterNotification<{genericArgs}>";
        var action = i == 0 ? "Action" : $"Action<{genericArgs}>";
        var handler = i == 0 ? "WeakActionEventHandler" : $"WeakActionEventHandler<{genericArgs}>";
        var eventHandler = i == 0 ? "IEventHandler" : $"IEventHandler<{parameterNotification}>";
        var weakEventHandler = i == 0 ? "IWeakEventHandler" : $"IWeakEventHandler<{parameterNotification}>";
        var parameterDefinitions = i == 0 ? string.Empty : (i == 1 ? "T param" : string.Join(", ", from index in Enumerable.Range(1, i) select $"T{index} param{index}"));
        var parameters = i == 0 ? string.Empty : (i == 1 ? "param" : string.Join(", ", from index in Enumerable.Range(1, i) select $"param{index}"));
        var notificationItems = i == 0 ? string.Empty : (i == 1 ? "notification.item" : string.Join(", ", from index in Enumerable.Range(1, i) select $"notification.item{index}"));
        var typeArguments = i == 0 ? string.Empty : (i == 1 ? "typeof(T), " : string.Join(", ", from index in Enumerable.Range(1, i) select $"typeof(T{index})") + ", ");
        var invokerAction = i == 0 ? "Action<TProvider>" : $"Action<TProvider, {genericArgs}>";
        var providerParameters = i == 0 ? "provider" : $"provider, {parameters}";
#>

    /// <summary>
    /// Event handler with System.Action which would reference the event provider by weak.
    /// </summary>
    public sealed class <#= handler #> : <#= eventHandler #>, <#= weakEventHandler #>, IWeakEventInvocation, IEquatable<<#= handler #>>
    {

        /// <summary>
        /// Delegate with instance method provider.
        /// </summary>
        private readonly IInvocation m_Invocation;

        /// <summary>
        /// The owner that control this weak event's lifecycle.
        /// </summary>
        private readonly WeakReference<object> m_Owner;

        /// <summary>
        /// Raw method of the event provider.
        /// </summary>
        private readonly MethodInfo m_Method;

        /// <summary>
        /// The method that this weak handler invokes.
        /// </summary>
        MethodInfo IWeakEventInvocation.invocationMethod => m_Method;

        object IWeakEventInvocation.invocationOwner => currentOwner;

        /// <summary>
        /// The owner that controls the lifecycle of this handler, or null when it was already collected.
        /// It takes part in the equality because two providers may invoke the same method.
        /// </summary>
        private object currentOwner => m_Owner.TryGetTarget(out var owner) ? owner : null;

        /// <summary>Whether the provider that owns this handler is still alive.</summary>
        public bool isAlive => m_Owner.TryGetTarget(out var owner) && !OwnerLifetime.comparer.Equals(owner, null) && m_Invocation.isAlive;

        /// <summary>
        /// Create a weak event handler from a System.Action.
        /// </summary>
        /// <param name="delegation">Delegation for creating EventHandler.</param>
        /// <param name="owner">The owner that control this weak event's lifecycle.</param>
        public WeakActionEventHandler(<#= action #> delegation, object owner)
        {
            if (OwnerLifetime.comparer.Equals(owner, null))
            {
                throw new ArgumentNullException(nameof(owner));
            }
            if (delegation is null)
            {
                throw new ArgumentNullException(nameof(delegation));
            }
            if (delegation.Target is null)
            {
                throw new ArgumentException("A weak subscription requires a delegate that targets an instance, a static method has no owner to keep alive.", nameof(delegation));
            }
            m_Owner = new WeakReference<object>(owner);
            m_Method = delegation.Method;
            var invokerType = typeof(ActionInvoker<>).MakeGenericType(<#= typeArguments #>delegation.Target.GetType());
            m_Invocation = Activator.CreateInstance(invokerType, delegation.Target, delegation) as IInvocation;
        }

        /// <inheritdoc/>
        public bool TryHandle(in <#= parameterNotification #> notification) => m_Owner.TryGetTarget(out var owner) && !OwnerLifetime.comparer.Equals(owner, null) && m_Invocation.Invoke(<#= notificationItems #>);

        /// <summary>Try to handle the notification and report whether the provider is still alive.</summary>
        public bool TryHandle(<#= parameterDefinitions #>) => m_Owner.TryGetTarget(out var owner) && !OwnerLifetime.comparer.Equals(owner, null) && m_Invocation.Invoke(<#= parameters #>);

        /// <inheritdoc/>
        public void Handle(in <#= parameterNotification #> notification)
        {
            if (m_Owner.TryGetTarget(out var owner) && !OwnerLifetime.comparer.Equals(owner, null))
            {
                m_Invocation.Invoke(<#= notificationItems #>);
            }
        }

        /// <summary>Handle the notification when the provider is still alive.</summary>
        public void Handle(<#= parameterDefinitions #>)
        {
            if (m_Owner.TryGetTarget(out var owner) && !OwnerLifetime.comparer.Equals(owner, null))
            {
                m_Invocation.Invoke(<#= parameters #>);
            }
        }

        /// <inheritdoc cref="System.Object.GetHashCode()"/>
        public override int GetHashCode() => unchecked((m_Method != null ? m_Method.GetHashCode() : 0) * 397 ^ (currentOwner != null ? currentOwner.GetHashCode() : 0));

        /// <summary>
        /// Verify if the target equals to event handler.
        /// </summary>
        public static bool operator ==(<#= handler #> left, object right) => !Equals(left, null) && left.Equals(right);

        /// <summary>
        /// Verify if the target not equals to event handler.
        /// </summary>
        public static bool operator !=(<#= handler #> left, object right) => !(left == right);

        /// <summary>
        /// Verify if the target equals to event handler.
        /// </summary>
        public bool Equals(<#= handler #> other) => other is not null && m_Method == other.m_Method && Equals(currentOwner, other.currentOwner);

        /// <summary>
        /// Verify if the target equals to event handler.
        /// </summary>
        public override bool Equals(object obj) => obj switch
        {
            <#= handler #> other => Equals(other),
            <#= action #> action => action.Method == m_Method && Equals(action.Target, currentOwner),
            IEventInvocation invocation => invocation.invocationMethod == m_Method && Equals(invocation.invocationOwner, currentOwner),
            _ => false
        };

        internal interface IInvocation
        {
            /// <summary>
            /// Whether the event provider that this invocation targets is still alive.
            /// </summary>
            bool isAlive { get; }

            bool Invoke(<#= parameterDefinitions #>);
        }

        internal sealed class ActionInvoker<TProvider> : IInvocation where TProvider : class
        {
            /// <summary>
            /// The event provider.
            /// </summary>
            private readonly WeakReference<TProvider> m_Provider;

            /// <summary>
            /// Wrapped action.
            /// </summary>
            private readonly <#= invokerAction #> m_Invocation;

            public ActionInvoker(TProvider provider, <#= action #> action)
            {
                m_Provider = new WeakReference<TProvider>(provider);
                m_Invocation = action.Method.CreateDelegate(typeof(<#= invokerAction #>)) as <#= invokerAction #>;
            }

            /// <summary>
            /// Whether the wrapped event provider is still alive.
            /// </summary>
            public bool isAlive => m_Provider.TryGetTarget(out _);

            public bool Invoke(<#= parameterDefinitions #>)
            {
                if (!m_Provider.TryGetTarget(out var provider))
                {
                    return false;
                }
                m_Invocation.Invoke(<#= providerParameters #>);
                return true;
            }
        }
    }
<#
    }
#>
}