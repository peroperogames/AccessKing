namespace PeroTools2.AccessKing;

public partial class CommandSchedule<TTheme>
{<#
for (var i = 0; i < 17; i++)
{
    var genericArgs = string.Empty;
    var genericArgsWithAngleBrackets = string.Empty;
    if (i > 0)
    {
        genericArgs = i == 1 ? "T" : string.Join(", ", from index in Enumerable.Range(1, i) select $"T{index}");
        genericArgsWithAngleBrackets = i == 1 ? "<T>" : $"<{string.Join(", ", from index in Enumerable.Range(1, i) select $"T{index}")}>";
    }
    var parameterNotification = i == 0 ? "Empty" : $"ParameterNotification<{genericArgs}>";
#>

    /// <summary>
    /// Get or create a command bus with <#=i#> argument<#=i > 1 ? "s" : string.Empty#> type parameter notification from schedule by theme.
    /// </summary>
    /// <param name="theme">Theme of command bus.</param>
    /// <returns>Command bus for the corresponding theme.</returns>
    public ICommandBus<<#=parameterNotification#>> Require<#=genericArgsWithAngleBrackets#>(TTheme theme)
    {
        // Get bus from cache.
        if (TryGetBus<<#=parameterNotification#>>(theme, out var bus)) return bus;

        // Build a new ParameterCommandBus.
        var commandBus = new ParameterCommandBus<#=genericArgsWithAngleBrackets#>();
        AddBus(theme, commandBus);
        return commandBus;
    }
<#
}
#>
}