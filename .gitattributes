# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Text files are stored and checked out as UTF-8 without BOM, LF only.
*.cs     text eol=lf
*.tt     text eol=lf
*.meta   text eol=lf
*.asmdef text eol=lf
*.json   text eol=lf
*.csproj text eol=lf
*.props  text eol=lf
*.sln    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.unity  text eol=lf
*.asset  text eol=lf
*.prefab text eol=lf

# Binaries.
*.dll          binary
*.pdb          binary
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.webp         binary
*.ico          binary
*.so           binary
*.aar          binary
*.jar          binary
*.zip          binary
*.unitypackage binary