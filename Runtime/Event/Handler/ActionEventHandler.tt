using System;

namespace PeroTools2.AccessKing
{<#
    for (var i = 0; i < 17; i++)
    {
        var genericArgs = string.Empty;
        var parameterDefinitions = string.Empty;
        var parameters = string.Empty;
        var notificationItems = string.Empty;
        if (i > 0)
        {
            genericArgs = i == 1 ? "T" : string.Join(", ", from index in Enumerable.Range(1, i) select $"T{index}");
            parameters = i == 1 ? "param" : string.Join(", ", from index in Enumerable.Range(1, i) select $"param{index}");
            parameterDefinitions = i == 1 ? "T param" : string.Join(", ", from index in Enumerable.Range(1, i) select $"T{index} param{index}");
            notificationItems = i == 1 ? "notification.item" : string.Join(", ", from index in Enumerable.Range(1, i) select $"notification.item{index}");
        }
        var parameterNotification = i == 0 ? "Empty" : $"ParameterNotification<{genericArgs}>";
        var action = i == 0 ? "Action" : $"Action<{genericArgs}>";
        var evenHandler = $"ActionEventHandler{(i == 0 ? string.Empty : $"<{genericArgs}>")}";
        var ievenHandler = $"IEventHandler{(i == 0 ? string.Empty : $"<{parameterNotification}>")}";
#>

    /// <summary>
    /// Event handler with System.Action.
    /// </summary>
    public sealed class <#=evenHandler#> : <#=ievenHandler#>, IEventInvocation, IEquatable<<#=evenHandler#>>
    {
        /// <summary>
        /// Delegate with instance method provider.
        /// </summary>
        private readonly <#=action#> m_Invocation;

        /// <summary>
        /// Create a event handler from a System.Action
        /// </summary>
        /// <param name="delegation">Delegation for creating EventHandler.</param>
        public ActionEventHandler(<#=action#> delegation) => m_Invocation = delegation;

        /// <summary>
        /// Exposes the invocation method, so that the event bus can locate this handler from the weak subscription that wraps the same delegate.
        /// </summary>
        System.Reflection.MethodInfo IEventInvocation.invocationMethod => m_Invocation?.Method;

        /// <inheritdoc cref="PeroTools2.AccessKing.IEventHandler.Handle"/>
        public void Handle(<#=parameterDefinitions#>) => m_Invocation?.Invoke(<#=parameters#>);

        /// <inheritdoc cref="PeroTools2.AccessKing.IEventHandler.Handle"/>
        public void Handle(in <#=parameterNotification#> notification) => Handle(<#=notificationItems#>);

        /// <inheritdoc cref="PeroTools2.AccessKing.<#=evenHandler.Replace('<','{').Replace('>','}')#>"/>
        public static implicit operator <#=evenHandler#>(<#=action#> delegation) => new(delegation);

        /// <inheritdoc cref="System.Object.GetHashCode()"/>
        public override int GetHashCode() => m_Invocation != null ? m_Invocation.GetHashCode() : 0;

        /// <summary>
        /// Verify if the target equals to event handler.
        /// </summary>
        public static bool operator ==(<#=evenHandler#> left, object right) => !Equals(left, null) && left.Equals(right);

        /// <summary>
        /// Verify if the target not equals to event handler.
        /// </summary>
        public static bool operator !=(<#=evenHandler#> left, object right) => !(left == right);

        /// <summary>
        /// Verify if the target equals to event handler.
        /// </summary>
        public bool Equals(<#=evenHandler#> other) => other is not null && m_Invocation == other.m_Invocation;

        /// <summary>
        /// Verify if the target equals to event handler.
        /// </summary>
        public override bool Equals(object obj) => obj switch
        {
            <#=evenHandler#> other => Equals(other),
            <#=action#> action => action == m_Invocation,
            _ => false
        };
    }
<#
    }
#>
}
